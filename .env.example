# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is ignored by git.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser: never put secrets in them.

# Public URL of the app (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Dashboard > Project Settings > API Keys).
# For the local stack, run `npm run db:start` and copy API_URL and PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Added in later phases ---
# Phase 6 (Resend + cron): RESEND_API_KEY, RESEND_WEBHOOK_SECRET, CRON_SECRET, UNSUBSCRIBE_TOKEN_SECRET
# Phase 7 (Stripe): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_BASIC, STRIPE_PRICE_PRO, STRIPE_PRICE_BUSINESS
