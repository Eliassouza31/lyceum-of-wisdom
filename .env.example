# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is ignored by git.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser: never put secrets in them.

# Public URL of the app (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Dashboard > Project Settings > API Keys).
# For the local stack, run `npm run db:start` and copy API_URL and PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Phase 6: email reminders (server-only secrets: NEVER prefix them with NEXT_PUBLIC_) ---
# Supabase Dashboard > Project Settings > API Keys > Secret keys. Used only by the
# reminder dispatcher (/api/cron/dispatch) and the Resend webhook. Local: `npx supabase status`.
SUPABASE_SECRET_KEY=
# Resend > API Keys (permission: "Sending access").
RESEND_API_KEY=
# Sender address on a domain verified in Resend. Leave empty to use Resend's test
# address (onboarding@resend.dev), which only delivers to your own Resend account email.
RESEND_FROM_EMAIL=
# Resend > Webhooks > your endpoint > Signing secret (starts with whsec_).
RESEND_WEBHOOK_SECRET=
# The cron secret is generated inside Supabase (Vault) by the phase 6 migration; no variable needed.

# --- Phase 7: plans and payments (Stripe, server-only) ---
# Stripe > Developers > API keys > Secret key (sk_test_... while testing).
STRIPE_SECRET_KEY=
# Stripe > Developers > Webhooks > your endpoint > Signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Stripe > Product catalog > each plan > monthly price ID (price_...).
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Phase 8: error monitoring (Sentry) ---
# Sentry > Project Settings > Client Keys (DSN). Public by design (the browser
# needs it), so it has the NEXT_PUBLIC_ prefix. Leave empty to turn Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
